//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

/ {
    combos {
        compatible = "zmk,combos";

        to_game {
            bindings = <&to 8>;
            key-positions = <20 31>;
            layers = <0>;
        };

        lmet {
            bindings = <&kp LALT>;
            key-positions = <10 11>;
            layers = <0>;
        };

        rmet {
            bindings = <&kp RALT>;
            key-positions = <19 18>;
            layers = <0>;
        };

        lalt {
            bindings = <&kp LCTRL>;
            key-positions = <11 12>;
            layers = <0>;
        };

        ralt {
            bindings = <&kp RCTRL>;
            key-positions = <18 17>;
            layers = <0>;
        };

        lctl {
            bindings = <&kp LSHFT>;
            key-positions = <12 13>;
            layers = <0>;
        };

        rctl {
            bindings = <&kp RSHFT>;
            key-positions = <17 16>;
            layers = <0>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&macro_tap>,
                <&macro_release>,
                <&macro_tap>;
        };
    };

    behaviors {
        dpm: doubletap_passthrough_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "DOUBLETAP_PASSTHROUGH_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <170>;
            flavor = "tap-preferred";
        };

        dpl: doubletap_passthrough_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "DOUBLETAP_PASSTHROUGH_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <190>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <170>;
        };

        dctbl: doubletap_change_to_base_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLETAP_CHANGE_TO_BASE_LAYER";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                                                &kp Q             &kp W        &kp F         &kp P         &kp B         &kp J         &kp L             &kp U          &kp Y        &kp SINGLE_QUOTE
                                                &dpm LEFT_META A  &dpm LALT R  &dpm LCTRL S  &dpm LSHFT T  &kp G         &kp M         &dpm RSHFT N      &dpm RCTRL E   &dpm RALT I  &dpm RIGHT_META O
&dpm LS(LA(LC(LEFT_META))) LANG_ZENKAKUHANKAKU  &dpl 3 Z          &kp X        &kp C         &kp D         &kp V         &kp K         &kp H             &kp COMMA      &kp DOT      &dpl 3 SLASH       &kp RS(RA(RC(RIGHT_META)))
                                                                               &dpl 4 ESC    &dpl 1 SPACE  &dpl 2 TAB    &dpl 6 ENTER  &dpl 5 BACKSPACE  &dpl 7 DELETE
            >;
        };

        navigation {
            label = "NAV";
            bindings = <
                           &none          &none         &none      &none           &none    &kp K_REDO  &kp K_PASTE    &kp K_COPY     &kp K_CUT    &kp K_UNDO
                           &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &kp LEFT    &kp DOWN       &kp UP         &kp RIGHT    &kp CAPSLOCK
&kp LS(LA(LC(LEFT_META)))  &none          &none         &none      &none           &none    &kp INS     &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP  &kp END       &none
                                                        &none      &none           &none    &kp ENTER   &kp BACKSPACE  &kp DELETE
            >;
        };

        mouse {
            label = "MOUSE";
            bindings = <
                           &none          &none         &none      &none           &none    &kp K_REDO       &kp K_PASTE     &kp K_COPY    &kp K_CUT        &kp K_UNDO
                           &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&kp LS(LA(LC(LEFT_META)))  &none          &none         &none      &none           &none    &msc SCRL_RIGHT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none       &none
                                                        &none      &none           &none    &mkp RCLK        &mkp LCLK       &mkp MCLK
            >;
        };

        button {
            bindings = <
                           &kp K_UNDO     &kp K_CUT     &kp K_COPY  &kp K_PASTE     &kp K_REDO    &kp K_REDO  &kp K_PASTE      &kp K_COPY  &kp K_CUT      &kp K_UNDO
                           &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL   &kp LEFT_SHIFT  &none         &none       &kp RIGHT_SHIFT  &kp RCTRL   &kp RIGHT_ALT  &kp RIGHT_META
&kp LS(LA(LC(LEFT_META)))  &kp K_UNDO     &kp K_CUT     &kp K_COPY  &kp K_PASTE     &kp K_REDO    &kp K_REDO  &kp K_PASTE      &kp K_COPY  &kp K_CUT      &kp K_UNDO      &kp RS(RA(RC(RIGHT_META)))
                                                        &mkp MCLK   &mkp LCLK       &mkp RCLK     &mkp RCLK   &mkp LCLK        &mkp MCLK
            >;

            label = "BUT";
        };

        media {
            label = "MEDIA";
            bindings = <
                           &none          &none         &none      &none           &none    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF    &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI
                           &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &kp C_PREVIOUS   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &ext_power EP_TOG
&kp LS(LA(LC(LEFT_META)))  &none          &none         &none      &none           &none    &out OUT_TOG     &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3       &none
                                                        &none      &none           &none    &kp C_STOP       &kp C_PLAY_PAUSE   &kp C_MUTE
            >;
        };

        numpad {
            label = "NUM";
            bindings = <
         &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET    &none  &none            &none      &none          &none
         &kp SEMICOLON     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL            &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_META
&kp ESC  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH        &none  &none            &none      &none          &none           &kp RS(RA(RC(RIGHT_META)))
                                         &kp PERIOD    &kp NUMBER_0  &kp MINUS            &none  &none            &none
            >;
        };

        symbols {
            label = "SYM";
            bindings = <
         &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &none  &none            &none      &none          &none
         &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_META
&kp ESC  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN           &kp POUND              &kp PIPE           &none  &none            &none      &none          &none           &kp RS(RA(RC(RIGHT_META)))
                                          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &none  &none            &none
            >;
        };

        function {
            label = "FUN";
            bindings = <
         &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN          &none  &none            &none      &none          &none
         &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK     &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_META
&kp ESC  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &none  &none            &none      &none          &none           &kp RS(RA(RC(RIGHT_META)))
                          &kp K_APP  &kp SPACE  &kp TAB            &none  &none            &none
            >;
        };

        game {
            bindings = <
        &kp Q      &kp E     &kp W    &kp F      &kp SLASH    &none  &none  &none  &none  &none
        &kp LCTRL  &kp A     &kp S    &kp D      &kp T        &none  &none  &none  &none  &none
&dctbl  &kp LSHFT  &kp LALT  &none    &kp F5     &kp TAB      &none  &none  &none  &none  &none  &none
                             &kp ESC  &kp SPACE  &none        &none  &none  &none
            >;

            label = "GAME";
        };
    };
};
